[Unit]
Description=La Betaillere Data Engine V4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/labetaillere-data-v4
Environment=NODE_ENV=production
Environment=LB_DATA_HOST=127.0.0.1
Environment=LB_DATA_PORT=3120
Environment=LB_STATS_BASE=http://127.0.0.1:3099
Environment=LB_CORS_ORIGIN=https://www.labetaillere.fr
ExecStart=/usr/bin/node /opt/labetaillere-data-v4/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
