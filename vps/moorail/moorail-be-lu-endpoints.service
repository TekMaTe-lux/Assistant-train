[Unit]
Description=MooRail BE-LU verified endpoint bridge (read-only providers)
After=network.target
ConditionPathExists=/opt/labetaillere-map-v2-src/map-v2/public/data/france-v5-meta.json

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0022
ExecStart=/usr/bin/python3 -B /opt/lb-rail-engine-v1/app/build_be_lu_endpoint_bridge.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/labetaillere-map-v2-src/map-v2/public/data
MemoryMax=144M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=50
