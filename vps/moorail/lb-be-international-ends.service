[Unit]
Description=La Betaillere Belgian international train endpoints from MooRail existing feeds
After=network.target
ConditionPathExists=/opt/labetaillere-map-v2-src/map-v2/public/data/france-v5-meta.json

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 -B /opt/lb-rail-engine-v1/app/build_be_international_lb_index.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/labetaillere-map-v2-src/map-v2/public/data
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=192M
TimeoutStartSec=55
