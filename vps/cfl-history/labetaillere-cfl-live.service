[Unit]
Description=La Betaillere - CFL per-stop public status (from local archives only)
After=local-fs.target
ConditionPathExists=/var/lib/labetaillere-cfl-history/observations.sqlite3

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0027
WorkingDirectory=/opt/labetaillere-cfl-live
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/labetaillere-cfl-live/publish_live_stops.py
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/gtfs /var/lib/labetaillere-cfl-live /var/lib/labetaillere-cfl-history
MemoryMax=128M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=20
