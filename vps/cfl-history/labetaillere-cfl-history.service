[Unit]
Description=La Betaillere - independent CFL/HAFAS history recorder
After=local-fs.target
ConditionPathExists=/var/lib/labetaillere-hafas/cfl-stop-state-v2.json

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0027
WorkingDirectory=/opt/labetaillere-cfl-history
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LB_CFL_PUBLIC_SUMMARY=/var/www/gtfs/cfl-history/summary.json
ExecStart=/usr/bin/python3 -B /opt/labetaillere-cfl-history/recorder.py
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/labetaillere-cfl-history /var/www/gtfs/cfl-history
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=192M
TimeoutStartSec=45
