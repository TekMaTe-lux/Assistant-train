+.station-pin-body{fill:#07314a;stroke:#31e7f2;stroke-width:1.8;stroke-linejoin:round}
+.station-pin-roof{fill:none;stroke:#d9fbff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
+.station-pin-building{fill:#0b5d78;stroke:#d9fbff;stroke-width:1.35;rx:1}
+.station-pin-door{fill:#f5c451}
+.station-pin-rail{fill:none;stroke:#f5c451;stroke-width:1.35;stroke-linecap:round}
+.station-dot-svg{width:28px;height:28px;overflow:visible;pointer-events:none}
+.station-dot-halo{fill:#06131f;stroke:#f7fbff;stroke-width:2.6}
+.station-dot-body{fill:#08384c;stroke:#31e7f2;stroke-width:1.5}
+.station-dot-roof{fill:none;stroke:#d9fbff;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
+.station-dot-hut{fill:#0b6078;stroke:#d9fbff;stroke-width:1;rx:.7}
+.station-dot-door{fill:#f5c451}
+.leaflet-marker-icon:has(.station-marker){pointer-events:auto!important}
+.leaflet-marker-icon:has(.station-marker.station-major){z-index:2600!important}
+.leaflet-marker-icon:has(.station-marker.station-regular){z-index:2200!important}
