+<!-- BER TRON CRISP MAP LAYERS V1 START -->
+<style id="ber-tron-crisp-map-layers-v1">
+/*
+ * Trois plans visuels francs :
+ * 1. fond et réseau froids ;
+ * 2. gares petites, opaques et nettes ;
+ * 3. trains colorés, détourés et au-dessus.
+ */
+html {
+  --ber-regular-station-opacity:.94;
+  --ber-major-station-opacity:1;
+}
+html.ber-arrow-z-far {
+  --ber-regular-station-opacity:.76;
+  --ber-major-station-opacity:.92;
+}
+html.ber-arrow-z-wide {
+  --ber-regular-station-opacity:.84;
+  --ber-major-station-opacity:.95;
+}
+html.ber-arrow-z-axis {
+  --ber-regular-station-opacity:.90;
+  --ber-major-station-opacity:.98;
+}
+
+/* Gare secondaire : petit disque technique, sans halo flou. */
+.leaflet-marker-pane .station-marker.station-regular {
+  filter:drop-shadow(0 1px 0 rgba(0,8,15,.98)) !important;
+}
+.leaflet-marker-pane .station-marker.station-regular .station-dot-svg {
+  opacity:var(--ber-regular-station-opacity) !important;
+  filter:none !important;
+}
+.leaflet-marker-pane .station-marker.station-regular .station-dot-halo {
+  fill:#020a11 !important;
+  stroke:#f4feff !important;
+  stroke-width:2.15 !important;
+}
+.leaflet-marker-pane .station-marker.station-regular .station-dot-body {
+  fill:#087cff !important;
+  stroke:#64f3ff !important;
+  stroke-width:1.15 !important;
+}
+
+/* Les gares principales restent froides et précises. */
+.leaflet-marker-pane .station-marker.station-major {
+  filter:
+    drop-shadow(0 1px 0 rgba(0,8,15,1))
+    drop-shadow(0 2px 1px rgba(0,8,15,.78))
+    !important;
+}
+.leaflet-marker-pane .station-marker.station-major .station-pin-svg {
+  opacity:var(--ber-major-station-opacity) !important;
+}
+
+/*
+ * Train : liseré sombre, filet blanc froid, cœur vif et ombre courte.
+ * Les ombres ont un rayon minimal pour obtenir un relief net, pas un nuage.
+ */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-svg {
+  filter:
+    drop-shadow(0 -1px 0 rgba(255,255,255,.96))
+    drop-shadow(0 1px 0 var(--ber-live-train-glow,rgba(124,255,0,.98)))
+    drop-shadow(0 2px 1px rgba(0,4,9,.98))
+    !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-outer {
+  stroke:#01070d !important;
+  stroke-opacity:1 !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-white {
+  stroke:#f7feff !important;
+  stroke-opacity:1 !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-core {
+  fill:var(--ber-live-train-color) !important;
+  stroke:var(--ber-live-train-color) !important;
+  stroke-width:.55 !important;
+  paint-order:stroke fill !important;
+}
+
+/* Sélection : davantage de contraste, sans halo large ni perte du cap. */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-selected
+.ber-train-arrow-svg,
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.ber-focus-current
+.ber-train-arrow-svg {
+  filter:
+    drop-shadow(0 -1px 0 #fff)
+    drop-shadow(0 1px 0 var(--ber-live-train-glow,rgba(124,255,0,1)))
+    drop-shadow(0 3px 1px #000)
+    !important;
+}
+</style>
+<!-- BER TRON CRISP MAP LAYERS V1 END -->
+
 </html>
