+++ b/map-v2/public/carte-core-preview.html
@@ -20189,4 +20189,89 @@
 })();
 </script>
 
+<!-- BER RESPONSIVE TRAIN ARROWS V1 START -->
+<style id="ber-responsive-train-arrows-v1">
+/* Le bouton Leaflet conserve une cible de clic de 40 px. Seul le dessin
+   rétrécit aux vues régionales afin de ne pas masquer le réseau. */
+html { --ber-arrow-zoom-scale: .74; }
+
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.cow-glyph {
+  transform:
+    translate(-50%, -50%)
+    rotate(var(--ber-heading, 0deg))
+    scale(var(--ber-arrow-zoom-scale))
+    !important;
+  transform-origin: 50% 50% !important;
+}
+
+html.ber-arrow-z-far  { --ber-arrow-zoom-scale: .56; }
+html.ber-arrow-z-wide { --ber-arrow-zoom-scale: .65; }
+html.ber-arrow-z-axis { --ber-arrow-zoom-scale: .74; }
+html.ber-arrow-z-city { --ber-arrow-zoom-scale: .84; }
+html.ber-arrow-z-near { --ber-arrow-zoom-scale: .94; }
+html.ber-arrow-z-close{ --ber-arrow-zoom-scale: 1; }
+
+/* Le train choisi reste à peine renforcé, sans redevenir envahissant. */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-selected
+.cow-glyph,
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.ber-focus-current
+.cow-glyph {
+  transform:
+    translate(-50%, -50%)
+    rotate(var(--ber-heading, 0deg))
+    scale(calc(var(--ber-arrow-zoom-scale) * 1.10))
+    !important;
+}
+
+@media (max-width:720px) {
+  html { --ber-arrow-mobile-factor: .94; }
+  html body.ber-marker-arrow-mode
+  .leaflet-marker-pane
+  .cow-marker
+  .cow-glyph {
+    scale: var(--ber-arrow-mobile-factor);
+  }
+}
+</style>
+
+<script id="ber-responsive-train-arrows-v1-script">
+(() => {
+  'use strict';
+  if (window.__BER_RESPONSIVE_TRAIN_ARROWS_V1__) return;
+  window.__BER_RESPONSIVE_TRAIN_ARROWS_V1__ = true;
+
+  const classes = [
+    'ber-arrow-z-far',
+    'ber-arrow-z-wide',
+    'ber-arrow-z-axis',
+    'ber-arrow-z-city',
+    'ber-arrow-z-near',
+    'ber-arrow-z-close'
+  ];
+
+  function syncArrowScale(){
+    const zoom = Number(map?.getZoom?.() ?? 9);
+    const next = zoom <= 7 ? classes[0]
+      : zoom === 8 ? classes[1]
+      : zoom === 9 ? classes[2]
+      : zoom === 10 ? classes[3]
+      : zoom === 11 ? classes[4]
+      : classes[5];
+    document.documentElement.classList.remove(...classes);
+    document.documentElement.classList.add(next);
+  }
+
+  map?.on?.('zoomend', syncArrowScale);
+  syncArrowScale();
+})();
+</script>
+<!-- BER RESPONSIVE TRAIN ARROWS V1 END -->
+
 </html>
