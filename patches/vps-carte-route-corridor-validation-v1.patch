+  /*
+   * BER SELECTED ROUTE CORRIDOR VALIDATION V1
+   *
+   * Un path peut être continu techniquement tout en empruntant une mauvaise
+   * branche du réseau. On valide donc le parcours gare par gare :
+   * - chaque arrêt doit être rencontré dans l'ordre ;
+   * - la voie doit passer réellement à proximité de la gare ;
+   * - aucun tronçon entre deux gares ne peut former un détour aberrant.
+   *
+   * Si un seul contrôle échoue, drawSelectedTripRoute() reconstruit le trajet
+   * avec les segments ferroviaires sûrs existants. Aucune ligne droite n'est
+   * dessinée en secours.
+   */
+  function validateSelectedRouteCorridor(coords, seq){
+    const route = berNormalizeSelectedRouteCoords(coords);
+    if (route.length < 2 || !Array.isArray(seq) || seq.length < 2) return null;
+
+    const stops = seq
+      .map(stopTime => stopsById.get(stopTime?.stop_id))
+      .filter(stop => (
+        stop
+        && Number.isFinite(Number(stop.lat))
+        && Number.isFinite(Number(stop.lon))
+      ));
+    if (stops.length < 2) return null;
+
+    const cumulative = [0];
+    for (let i=1; i<route.length; i++){
+      const edge = distLL(
+        { lat:route[i-1][0], lon:route[i-1][1] },
+        { lat:route[i][0], lon:route[i][1] }
+      );
+      if (!Number.isFinite(edge) || edge > RAIL_MAX_EDGE_M) return null;
+      cumulative.push(cumulative[i-1] + edge);
+    }
+
+    const projections = [];
+    let cursor = 0;
+    for (const stop of stops){
+      let bestIndex = -1;
+      let bestDistance = Infinity;
+      for (let i=cursor; i<route.length; i++){
+        const distance = distLL(
+          stop,
+          { lat:route[i][0], lon:route[i][1] }
+        );
+        if (distance < bestDistance){
+          bestDistance = distance;
+          bestIndex = i;
+        }
+      }
+
+      /* Tolérance pour les points d'arrêt décalés du quai, sans accepter une
+         autre ligne ferroviaire située dans la même région. */
+      if (bestIndex < 0 || !Number.isFinite(bestDistance) || bestDistance > 1600){
+        return null;
+      }
+      projections.push(bestIndex);
+      cursor = bestIndex;
+    }
+
+    for (let i=0; i<stops.length-1; i++){
+      const directDistance = distLL(stops[i], stops[i+1]);
+      const railDistance = cumulative[projections[i+1]] - cumulative[projections[i]];
+      const corridorLimit = Math.max(directDistance * 3.25, directDistance + 12000);
+      if (
+        !Number.isFinite(directDistance)
+        || !Number.isFinite(railDistance)
+        || railDistance <= 0
+        || railDistance > corridorLimit
+      ){
+        return null;
+      }
+    }
+
+    return route;
+  }
