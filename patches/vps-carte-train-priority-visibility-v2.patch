 <!-- BER RESPONSIVE STATIONS + TRAIN CONTRAST V1 END -->
 
+<!-- BER TRAIN PRIORITY VISIBILITY V2 START -->
+<style id="ber-train-priority-visibility-v2">
+/* Hiérarchie visuelle : les points de gare servent de repères de fond,
+   les flèches représentent l'information vivante au premier plan. */
+html {
+  --ber-regular-station-opacity:.62;
+  --ber-major-station-opacity:.90;
+}
+html.ber-arrow-z-far {
+  --ber-regular-station-opacity:.30;
+  --ber-major-station-opacity:.72;
+}
+html.ber-arrow-z-wide {
+  --ber-regular-station-opacity:.42;
+  --ber-major-station-opacity:.78;
+}
+html.ber-arrow-z-axis {
+  --ber-regular-station-opacity:.56;
+  --ber-major-station-opacity:.86;
+}
+html.ber-arrow-z-city {
+  --ber-regular-station-opacity:.70;
+  --ber-major-station-opacity:.94;
+}
+html.ber-arrow-z-near,
+html.ber-arrow-z-close {
+  --ber-regular-station-opacity:.88;
+  --ber-major-station-opacity:1;
+}
+
+.leaflet-marker-pane .station-marker.station-regular .station-dot-svg {
+  opacity:var(--ber-regular-station-opacity) !important;
+}
+.leaflet-marker-pane .station-marker.station-major .station-pin-svg {
+  opacity:var(--ber-major-station-opacity) !important;
+}
+.leaflet-marker-pane .station-marker.station-regular .station-dot-halo {
+  fill:#101b24 !important;
+  stroke:rgba(218,232,239,.76) !important;
+  stroke-width:1.55 !important;
+}
+.leaflet-marker-pane .station-marker.station-regular .station-dot-body {
+  fill:#7895a3 !important;
+  stroke:#102431 !important;
+  stroke-width:1 !important;
+}
+.leaflet-marker-pane .station-marker:hover svg,
+.leaflet-marker-pane .station-marker:focus-visible svg {
+  opacity:1 !important;
+}
+
+/* Flèches très lisibles sans revenir aux grandes icônes. */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-svg {
+  opacity:1 !important;
+  filter:
+    drop-shadow(0 0 1px rgba(255,255,255,.92))
+    drop-shadow(0 1px 1px rgba(0,0,0,.98))
+    !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-outer {
+  stroke:#02080d !important;
+  stroke-opacity:1 !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
+.ber-train-arrow-white {
+  stroke:#fff !important;
+  stroke-opacity:1 !important;
+}
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-sncf
+.ber-train-arrow-core { fill:#00c8ff !important; }
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-cfl
+.ber-train-arrow-core { fill:#ff337d !important; }
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-tgv-roi
+.ber-train-arrow-core { fill:#ffd020 !important; }
+
+/* Le train sélectionné ressort encore davantage, sans changer d'orientation. */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.train-selected
+.ber-train-arrow-svg,
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker.ber-focus-current
+.ber-train-arrow-svg {
+  filter:
+    drop-shadow(0 0 2px #fff)
+    drop-shadow(0 0 4px rgba(0,210,255,.88))
+    drop-shadow(0 1px 1px #000)
+    !important;
+}
+</style>
+<!-- BER TRAIN PRIORITY VISIBILITY V2 END -->
+
 </html>
