+}
+.leaflet-marker-pane .station-marker.station-regular:hover .station-dot-svg,
+.leaflet-marker-pane .station-marker.station-regular:focus-visible .station-dot-svg {
+  transform:scale(calc(var(--ber-station-regular-scale) * 1.18)) !important;
