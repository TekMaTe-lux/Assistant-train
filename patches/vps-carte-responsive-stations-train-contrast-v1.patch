+}
+.leaflet-marker-pane .station-marker.station-major:hover .station-pin-svg,
+.leaflet-marker-pane .station-marker.station-major:focus-visible .station-pin-svg {
+  transform:scale(calc(var(--ber-station-major-scale) * 1.10)) !important;
+  filter:drop-shadow(0 0 4px rgba(49,231,242,.9));
+}
+
+/* Contraste net des trains sans augmenter leur taille. */
+html body.ber-marker-arrow-mode
+.leaflet-marker-pane
+.cow-marker
