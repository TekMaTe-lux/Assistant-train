+<!-- BER RESPONSIVE STATIONS + TRAIN CONTRAST V1 START -->
+<style id="ber-responsive-stations-train-contrast-v1">
+/* Les repères gardent leur surface de clic Leaflet ; seul leur SVG change
+   visuellement de taille. Les trains restent au-dessus (z-index 1000). */
+html {
+  --ber-station-regular-scale:.68;
+  --ber-station-major-scale:.88;
+  --ber-train-outer-width:3.7;
+  --ber-train-white-width:2.25;
+}
+
+html.ber-arrow-z-far {
+  --ber-station-regular-scale:.48;
+  --ber-station-major-scale:.70;
+  --ber-train-outer-width:3.1;
+  --ber-train-white-width:1.75;
+}
+html.ber-arrow-z-wide {
+  --ber-station-regular-scale:.57;
+  --ber-station-major-scale:.78;
+  --ber-train-outer-width:3.35;
+  --ber-train-white-width:1.95;
+}
+html.ber-arrow-z-axis {
+  --ber-station-regular-scale:.68;
+  --ber-station-major-scale:.88;
+}
+html.ber-arrow-z-city {
+  --ber-station-regular-scale:.78;
+  --ber-station-major-scale:.94;
+  --ber-train-outer-width:4;
+  --ber-train-white-width:2.45;
+}
+html.ber-arrow-z-near {
+  --ber-station-regular-scale:.88;
+  --ber-station-major-scale:1;
+  --ber-train-outer-width:4.25;
+  --ber-train-white-width:2.65;
+}
+html.ber-arrow-z-close {
+  --ber-station-regular-scale:.95;
+  --ber-station-major-scale:1;
+  --ber-train-outer-width:4.4;
+  --ber-train-white-width:2.8;
+}
+
+.leaflet-marker-pane .station-marker {
+  transform:none !important;
+}
+.leaflet-marker-pane .station-marker .station-dot-svg {
+  transform:scale(var(--ber-station-regular-scale)) !important;
+  transform-origin:50% 50% !important;
+  transition:transform .15s ease,filter .15s ease !important;
+}
+.leaflet-marker-pane .station-marker .station-pin-svg {
+  transform:scale(var(--ber-station-major-scale)) !important;
+  transform-origin:50% 92% !important;
